    "dev": "node --env-file-if-exists=.env --experimental-strip-types demo.js",
    "start": "node --env-file-if-exists=.env --experimental-strip-types demo.js"
  },
  "engines": {
    "node": ">=22.9.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@babel/parser": "^7.26.9",
    "@babel/traverse": "^7.26.9"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "22.20.2",
    "typescript": "7.0.2"
  }
}
