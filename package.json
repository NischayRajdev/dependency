{
  "name": "fides",
  "version": "1.0.0",
  "description": "Fides is our MUJHackX 4.0 solution for Cybersecurity PS12: Software Supply Chain Dependency Risk Analyser.",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
